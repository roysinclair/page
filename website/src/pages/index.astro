---
import Layout from '../layouts/Layout.astro';
import Field from '../components/Field.astro';
import Window from '../components/Window.astro';
import Device from '../components/Device.astro';
import ProductIcon from '../components/ProductIcon.astro';
import Icon from '../components/Icon.astro';
import Pic from '../components/Pic.astro';
import Flow from '../components/Flow.astro';
import TrustBand from '../components/TrustBand.astro';
import HoldRing from '../components/HoldRing.astro';
import Showcase from '../components/Showcase.astro';
import { u, GITHUB, GUIDE, PDF, AURA_APP, AURA_GUIDE, ORBIT_DEMO, ORBIT_GUIDE, STUDIO_RELEASES } from '../data/site';

// The pages your phone can get through Page Relay, across the family. From the kinds of page in data/site.ts (Page Studio),
// docs/AURA-LINK.md (Page Aura) and docs/ORBIT-LINK.md (Page Orbit).
const moments = [
  { p: 'power', kind: 'Approval', when: 'A tool call or plan from Claude Code is waiting for your OK.', act: 'Approve · Deny · Deny with instructions' },
  { p: 'power', kind: 'Looks stuck', when: 'The same command failed three times in a row, or nothing was written for 15 minutes.', act: 'Steer · Stop it' },
  { p: 'power', kind: 'Low battery', when: 'Your agents were paused at your cutoff, each with a two-line summary.', act: 'Carry on · stay paused' },
  { p: 'aura', kind: 'Tool request', when: 'A chat asks to use an app on your computer (a local MCP tool).', act: 'Allow once · Deny' },
  { p: 'aura', kind: 'Reply ready', when: 'A reply finished while you were away from your computer.', act: 'Read the end · send a message' },
  { p: 'orbit', kind: 'Approval', when: 'An agent wants to run a command or use a tool that asks first.', act: 'Allow once · Deny' },
  { p: 'orbit', kind: 'Finished', when: 'A session finished while you were away, with the end of its last message.', act: 'Reply with its next task' },
] as const;
const pname = { power: 'Page Studio', aura: 'Page Aura', orbit: 'Page Orbit' } as const;
---
<Layout current="" world="studio" og={{ image: 'img/og/studio.webp', alt: 'Page Studio: run your AI agents, answer them from anywhere. Page Aura and Page Orbit windows behind an iPhone lock screen paged by Page Relay.' }}>
  <!-- ================================================================ HERO -->
  <section class="relative isolate overflow-hidden pb-10 pt-14 sm:pt-20">
    <Field layout="hero" />
    <div class="wrap-wide text-center">
      <a href="#apps" class="eyebrow">
        <span class="flex -space-x-1.5">
          <ProductIcon product="power" size={22} class="rounded-[7px] ring-2 ring-night-900" />
          <ProductIcon product="aura" size={22} class="rounded-[7px] ring-2 ring-night-900" />
          <ProductIcon product="orbit" size={22} class="rounded-[7px] ring-2 ring-night-900" />
        </span>
        <span>Page Studio · free apps<span class="hidden sm:inline"> you run yourself</span></span>
      </a>
      <h1 class="display mx-auto mt-7 max-w-[1240px]">Run your AI agents. <span class="text-spectrum block pb-2">Answer them from anywhere.</span></h1>
      <p class="lede mx-auto mt-6 max-w-2xl">Keep your coding agents running, chat over the API on your own credits, and run cloud agents from one control room. When something needs you, Page Relay pages your phone. Nothing goes through us.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="#apps" class="btn-primary btn-lg">Meet the apps</a>
        <a href="#connect" class="btn-ghost btn-lg">How they connect</a>
      </div>
    </div>

    <!-- The family in one picture: Page Aura and Page Orbit on the desktop, Page Relay paging the phone in front. -->
    <div class="wrap-wide stage mt-14 sm:mt-20">
      <div class="hs tilt">
        <div class="hs-aura">
          <Window name="aura/hero" title="Page Aura" eager sizes="(min-width: 1024px) 640px, 70vw" alt="Page Aura with three chats side by side: a web search answer with a table and numbered sources, a sales chart made from an uploaded spreadsheet, and a researched price answer. The sidebar groups chats by date and shows an estimated balance." />
        </div>
        <div class="hs-orbit">
          <Window name="orbit/session" title="Page Orbit" eager sizes="(min-width: 1024px) 640px, 70vw" alt="A Page Orbit session: release notes written by an agent on the left, and a timeline of every event with its timing, tokens and cost on the right." />
        </div>
        <div class="hs-phone">
          <div class="rings" aria-hidden="true">
            <i style="--r:150%;--dl:0s"></i><i style="--r:150%;--dl:-2s"></i><i style="--r:150%;--dl:-4s"></i>
          </div>
          <Device name="power/lock" eager sizes="(min-width: 1024px) 300px, 40vw" alt="An iPhone lock screen paged by Page Relay: a live activity reading 2 need you, 5 working, as bottle-flip wants to delete builds, with Open; and a page saying llm-play looks stuck after cargo test failed 6 times in a row." />
        </div>
        <div class="hs-chip hs-chip-aura floaty" style="--dl:-1s" aria-hidden="true"><ProductIcon product="aura" size={22} /> Reply ready</div>
        <div class="hs-chip hs-chip-orbit floaty" style="--dl:-3.5s" aria-hidden="true"><ProductIcon product="orbit" size={22} /> Approval needed</div>
      </div>
    </div>

    <!-- legend: what each one is, in a line -->
    <div class="wrap mt-12 sm:mt-16">
      <ul class="grid gap-3 md:grid-cols-3">
        <li>
          <a href="#power" class="legend world-power">
            <ProductIcon product="power" size={40} />
            <span><strong>Page Studio</strong><small>Page Power keeps your computer awake while coding agents work; Page Relay pages your phone.</small><small class="plat">macOS · Linux preview · iPhone · Android · your Cloudflare relay</small></span>
          </a>
        </li>
        <li>
          <a href="#aura" class="legend world-aura">
            <ProductIcon product="aura" size={40} />
            <span><strong>Page Aura</strong><small>Chat over the API on your own credits, with context, web search and tools.</small><small class="plat">Windows · macOS · Linux · browser</small></span>
          </a>
        </li>
        <li>
          <a href="#orbit" class="legend world-orbit">
            <ProductIcon product="orbit" size={40} />
            <span><strong>Page Orbit</strong><small>Manage, control and diagnose Anthropic’s Managed Agents.</small><small class="plat">Windows · macOS · Linux</small></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================================================================ THE APPS -->
  <div id="apps">
    <!-- PAGE STUDIO FOR MAC: PAGE POWER + PAGE RELAY -->
    <section id="power" class="world world-power relative isolate overflow-hidden py-24 sm:py-32">
      <Field layout="right" full />
      <div class="wrap-wide grid items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-10">
        <div data-reveal>
          <div class="flex items-center gap-4">
            <ProductIcon product="power" size={60} glow />
            <div><p class="text-[15px] font-semibold">Page Studio for Mac</p><p class="label mt-1">Page Power · Page Relay · iPhone · Android</p></div>
          </div>
          <h2 class="h2 world-h mt-8">Your agents keep working. <span class="text-world">You get paged only when it matters.</span></h2>
          <p class="lede mt-6">A Mac menu-bar app with two halves. Page Power keeps the Mac awake while Claude Code, Codex and local models work and pauses them gracefully at your battery cutoff. Page Relay pages your phone when a decision is yours and types your reply into the exact terminal that asked. A Linux preview runs headless.</p>
          <ul class="feats mt-8">
            <li><span class="ico"><Icon name="bolt" /></span><span><strong>Page Power: awake exactly as long as the work needs.</strong> Real session state, not CPU guesses, lid closed too on AC.</span></li>
            <li><span class="ico"><Icon name="battery" /></span><span><strong>A graceful pause at your cutoff.</strong> Agents stop and write a two-line summary, then the Mac sleeps.</span></li>
            <li><span class="ico"><Icon name="lock" /></span><span><strong>Page Relay: your own relay.</strong> A Worker on your Cloudflare account; live sessions are end-to-end encrypted.</span></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={u('mac/')} class="btn-primary btn-arrow">Explore Page Studio for Mac</a>
            <a href={u('iphone/')} class="btn-ghost">Page Relay for phones</a>
          </div>
        </div>
        <div class="halo lg:-mr-16 xl:-mr-24" data-reveal="scale" style="--d:120ms">
          <Showcase name="showcase/hero-visual" class="-mx-4 sm:mx-0" sizes="(min-width: 1024px) 660px, 100vw" alt="Page Studio across your devices, linked through Page Relay on your own Cloudflare account. An Android phone shows two items that need you, first an irreversible request to delete every Dev build with Deny and Hold; an iPhone lock screen shows two pages asking for approval; the Mac's menu-bar popover lists what needs you and what is working." />
        </div>
      </div>
    </section>

    <!-- PAGE AURA -->
    <section id="aura" class="world world-aura relative isolate overflow-hidden py-24 sm:py-32">
      <Field layout="left" full />
      <div class="wrap-wide grid items-center gap-14 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-14">
        <div class="relative order-2 lg:order-1 lg:-ml-8 xl:-ml-14" data-reveal="scale">
          <div class="halo relative mr-4 sm:mr-8">
            <Window name="aura/hero" title="Page Aura" sizes="(min-width: 1024px) 680px, 92vw" alt="Page Aura with three chats side by side, each with its own model and cost, and an estimated balance in the sidebar." />
            <div class="float-ui floaty -bottom-8 left-[4%] w-[66%] sm:-bottom-10" style="--dl:-2s">
              <Pic name="aura/approval" sizes="(min-width: 1024px) 460px, 62vw" alt="A Page Aura approval card: the model wants to read config/modem.yaml, with Deny, Always allow in this chat, and Allow once." />
            </div>
            <div class="float-ui floaty -right-4 -top-6 w-[34%] sm:-right-10 sm:-top-8" style="--dl:-4s">
              <Pic name="aura/balance" sizes="(min-width: 1024px) 230px, 34vw" alt="Page Aura's balance gauge: about $23.95 left, $0.14 today, $0.32 this month." />
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2" data-reveal>
          <div class="flex items-center gap-4">
            <ProductIcon product="aura" size={60} glow />
            <div><p class="text-[15px] font-semibold">Page Aura</p><p class="label mt-1">Chat · Windows · macOS · Linux · browser</p></div>
          </div>
          <h2 class="h2 world-h mt-8">A beautiful chat for Anthropic’s models, <span class="text-world">on your own key.</span></h2>
          <p class="lede mt-6">One HTML file, or a desktop app. Several chats side by side, web search with sources, code and files, memory and notes, and what every reply costs. No server, no account and no telemetry in between.</p>
          <ul class="feats mt-8">
            <li><span class="ico"><Icon name="key" /></span><span><strong>Your key, in your keychain.</strong> The desktop app adds it to each request, so the interface never sees it.</span></li>
            <li><span class="ico"><Icon name="shield" /></span><span><strong>Only api.anthropic.com.</strong> A strict content security policy, and every library embedded and checked.</span></li>
            <li><span class="ico"><Icon name="coin" /></span><span><strong>Every reply priced.</strong> A balance gauge for the credit you already pay for.</span></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={u('aura/')} class="btn-primary btn-arrow">Explore Page Aura</a>
            <a href={AURA_APP} rel="noopener" class="btn-ghost">Open it in your browser</a>
          </div>
        </div>
      </div>
    </section>

    <!-- PAGE ORBIT -->
    <section id="orbit" class="world world-orbit relative isolate overflow-hidden py-24 sm:py-32">
      <Field layout="right" full />
      <div class="wrap-wide grid items-center gap-14 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
        <div data-reveal>
          <div class="flex items-center gap-4">
            <ProductIcon product="orbit" size={60} glow />
            <div><p class="text-[15px] font-semibold">Page Orbit</p><p class="label mt-1">Agents · Windows · macOS · Linux</p></div>
          </div>
          <h2 class="h2 world-h mt-8">Mission control for <span class="text-world">your cloud agents.</span></h2>
          <p class="lede mt-6">A free desktop app for Anthropic’s Managed Agents: agents that work in their own cloud sandbox, on their own or on a schedule. Build them, talk to them live, see every step and every cent, and let a model diagnose what went wrong.</p>
          <ul class="feats mt-8">
            <li><span class="ico"><Icon name="layers" /></span><span><strong>Agents with versions.</strong> Every save is a version: compare any two, roll back with one click.</span></li>
            <li><span class="ico"><Icon name="timeline" /></span><span><strong>Every step, every cent.</strong> A timeline of each event, with timing, tokens and cost.</span></li>
            <li><span class="ico"><Icon name="activity" /></span><span><strong>Diagnose.</strong> A model explains what went wrong and proposes a fix you apply as a new version.</span></li>
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={u('orbit/')} class="btn-primary btn-arrow">Explore Page Orbit</a>
            <a href={ORBIT_DEMO} rel="noopener" class="btn-ghost">Try the demo</a>
          </div>
        </div>
        <div class="relative lg:-mr-8 xl:-mr-14" data-reveal="scale" style="--d:120ms">
          <div class="halo relative ml-2 mr-4 sm:ml-0 sm:mr-10">
            <Window name="orbit/session" title="Page Orbit" sizes="(min-width: 1024px) 680px, 92vw" alt="A Page Orbit session: the agent's conversation on the left, with a retry notice, and a timeline of every event with timing, tokens and cost on the right." />
            <div class="float-ui floaty -bottom-12 -right-4 w-[54%] sm:-right-12 sm:-bottom-16" style="--dl:-1.5s">
              <Pic name="orbit/diagnose" sizes="(min-width: 1024px) 380px, 54vw" alt="Diagnose in Page Orbit: a model suggests letting the agent read GitHub without asking, shows the change to the agent as a diff, and offers Apply as version 4." />
            </div>
            <div class="float-ui floaty -left-3 bottom-[18%] w-[32%] sm:-left-10" style="--dl:-3s">
              <Pic name="orbit/versions" sizes="(min-width: 1024px) 220px, 32vw" alt="An agent's versions in Page Orbit: v3 changed model (current), v2 changed system, v1 first version." />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ================================================================ CONNECT -->
  <section id="connect" class="relative isolate overflow-hidden py-24 sm:py-32">
    <Field layout="center" full />
    <div class="wrap-wide">
      <div class="sec-head center" data-reveal>
        <p class="label">Better together</p>
        <h2 class="h2">One phone for <span class="text-spectrum">all of it.</span></h2>
        <p class="lede mx-auto">Page Aura and Page Orbit hand their chats and sessions to Page Studio on the same computer. Page Relay carries the pages through your own relay to your phone, from any iPhone or Android device, and brings your answers back.</p>
      </div>
      <div class="glass-panel mt-14 px-4 py-6 md:px-10 md:py-11" data-reveal="scale">
        <Flow />
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        <li class="mini" data-reveal style="--d:0ms"><Icon name="lock" /><span><strong>A private local socket.</strong> Page Aura and Page Orbit only ever talk to Page Studio, on the same computer, readable only by you.</span></li>
        <li class="mini" data-reveal style="--d:90ms"><Icon name="cloud" /><span><strong>Your relay, your account.</strong> Your computer and your phone both connect out to it. Page Studio’s authors have no access.</span></li>
        <li class="mini" data-reveal style="--d:180ms"><Icon name="shield" /><span><strong>Sealed end to end.</strong> Live session content is encrypted with AES-256-GCM, with a key from the pairing QR.</span></li>
      </ul>
      <p class="fine mx-auto mt-8 max-w-3xl text-center" data-reveal>Page Aura and Page Orbit run on Windows, macOS and Linux. Page Studio, and with it Page Relay, runs on macOS, with a Linux preview (the <code class="code-inline">paged</code> service, built from source). On a Mac or a Linux machine running Page Studio, Page Aura and Page Orbit can page your phone. On Windows they work fully on their own.</p>
    </div>
  </section>

  <!-- ================================================================ MOMENTS -->
  <section id="moments" class="relative overflow-hidden py-24 sm:py-32">
    <div class="wrap-wide grid items-center gap-16 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <div class="relative mx-auto w-full max-w-[340px] world-power" data-reveal="scale">
        <div class="rings" aria-hidden="true"><i style="--r:170%;--dl:0s"></i><i style="--r:170%;--dl:-2s"></i><i style="--r:170%;--dl:-4s"></i></div>
        <Device name="power/decision" island sizes="(min-width: 1024px) 340px, 80vw" alt="The Page Relay decision sheet on iPhone for an undoable command: Run this command? swift test --filter StuckTests, which Page Studio will type into cmux on Studio MBP, with Approve, Deny and Tell it instead." class="relative" />
      </div>
      <div>
        <div class="sec-head" data-reveal>
          <p class="label">Only when it matters</p>
          <h2 class="h2">No ping for every step. <span class="text-spectrum">Just the moments that need you.</span></h2>
          <p class="lede">Approvals and questions page at once; idle and finished ones wait until you have stepped away. Answer from the lock screen, and see whether your answer landed.</p>
        </div>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2">
          {moments.map((m, i) => (
            <li class={`moment world-${m.p}`} data-reveal style={`--d:${(i % 4) * 70}ms`}>
              <div class="flex items-center gap-2.5">
                <ProductIcon product={m.p} size={22} />
                <span class="text-[12.5px] font-semibold text-ink-2">{pname[m.p]}</span>
                <span class="ml-auto font-mono text-[11px] font-bold uppercase tracking-[0.1em] text-accent">{m.kind}</span>
              </div>
              <p class="mt-3 text-[15px] leading-snug text-ink">{m.when}</p>
              <p class="mt-2 font-mono text-[12px] text-ink-3">{m.act}</p>
            </li>
          ))}
          <li class="moment danger" data-reveal style="--d:210ms">
            <div class="flex items-center gap-2.5">
              <ProductIcon product="power" size={22} />
              <span class="text-[12.5px] font-semibold text-ink-2">Irreversible</span>
            </div>
            <p class="mt-3 text-[15px] leading-snug text-ink">Deleting, force-pushing, deploying: press and hold, then Face ID.</p>
            <HoldRing class="mt-4" />
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================================================================ TRUST -->
  <section class="py-16 sm:py-20">
    <div class="wrap-wide">
      <div class="sec-head center mb-10" data-reveal>
        <p class="label">Yours to run</p>
        <h2 class="h2">Your key. Your devices. <span class="text-spectrum">Your rules.</span></h2>
      </div>
      <div data-reveal>
        <TrustBand items={[
          { icon: 'key', title: 'Your key, your keychain', body: 'Page Aura and Page Orbit keep it in the system keychain, out of the interface’s reach.' },
          { icon: 'server', title: 'No server in the middle', body: 'The apps talk straight to Anthropic, or through a relay on your own account.' },
          { icon: 'eye', title: 'No telemetry', body: 'No account, no analytics, no third-party scripts. Nothing goes to the authors.' },
          { icon: 'code', title: 'Read every line', body: 'Source-available, Page Studio License. Build it yourself.' },
          { icon: 'gift', title: 'Free', body: 'No subscription. The AI apps use the API credit you already have.' },
        ]} />
      </div>
    </div>
  </section>

  <!-- ================================================================ GET STARTED -->
  <section id="get-started" class="py-24 sm:py-32">
    <div class="wrap-wide">
      <div class="sec-head center" data-reveal>
        <p class="label">Get started</p>
        <h2 class="h2">Pick a door. <span class="text-spectrum">They all link up.</span></h2>
        <p class="lede mx-auto">Each app works on its own. To link Page Aura or Page Orbit to Page Relay, switch it on in each app and in Page Studio on the same computer. Nothing to deploy.</p>
      </div>
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        <article class="door world-power" data-reveal>
          <ProductIcon product="power" size={56} glow />
          <h3 class="mt-6 text-[26px] font-bold tracking-tight">Page Studio</h3>
          <p class="mt-3 text-ink-2">Build the Mac app (or the Linux preview), deploy your relay to Cloudflare, and pair your phone by QR. From nothing to a phone that pages you in 30 to 60 minutes.</p>
          <div class="mt-auto flex flex-wrap gap-2.5 pt-8">
            <a href={GUIDE} rel="noopener" class="btn-primary">Self-hosting guide</a>
            <a href={GITHUB} rel="noopener" class="btn-ghost">GitHub</a>
          </div>
          <a href={u('relay/#agent')} class="link mt-5 text-[14px] font-semibold">Or let Claude Code do the typing →</a>
        </article>
        <article class="door world-aura" data-reveal style="--d:90ms">
          <ProductIcon product="aura" size={56} glow />
          <h3 class="mt-6 text-[26px] font-bold tracking-tight">Page Aura</h3>
          <p class="mt-3 text-ink-2">Open it in your browser right now, or install the desktop app for Windows, macOS or Linux. Add your Anthropic API key and start a chat on your own credits.</p>
          <div class="mt-auto flex flex-wrap gap-2.5 pt-8">
            <a href={AURA_APP} rel="noopener" class="btn-primary">Open Page Aura</a>
            <a href={STUDIO_RELEASES} rel="noopener" class="btn-ghost">Download</a>
          </div>
          <a href={AURA_GUIDE} rel="noopener" class="link mt-5 text-[14px] font-semibold">Read the guide →</a>
        </article>
        <article class="door world-orbit" data-reveal style="--d:180ms">
          <ProductIcon product="orbit" size={56} glow />
          <h3 class="mt-6 text-[26px] font-bold tracking-tight">Page Orbit</h3>
          <p class="mt-3 text-ink-2">Explore the demo in your browser with a sample workspace, then install the desktop app and bring a key with Managed Agents available.</p>
          <div class="mt-auto flex flex-wrap gap-2.5 pt-8">
            <a href={ORBIT_DEMO} rel="noopener" class="btn-primary">Try the demo</a>
            <a href={STUDIO_RELEASES} rel="noopener" class="btn-ghost">Download</a>
          </div>
          <a href={ORBIT_GUIDE} rel="noopener" class="link mt-5 text-[14px] font-semibold">Read the guide →</a>
        </article>
      </div>
      <p class="fine mt-10 text-center">The installers aren’t code-signed: build them yourself, or check the SHA256 checksums that come with every release. <a class="link" href={u('brochure/')}>Read the brochure</a> or <a class="link" href={u(PDF)} download>download it as a PDF</a>.</p>
    </div>
  </section>
</Layout>

<style>
  /* ---- hero stage: Page Aura and Page Orbit lean in from the sides, the phone stands in front ---- */
  .hs { position: relative; aspect-ratio: 1 / 1.08; max-width: 1240px; margin: 0 auto; }
  .hs::before {
    content: ''; position: absolute; left: 6%; right: 6%; top: 18%; bottom: 8%; z-index: 0; border-radius: 50%; pointer-events: none;
    background: linear-gradient(90deg, #4f86ff, #22d3c5 30%, #5EEAD4 50%, #b73bce 72%, #da2978); filter: blur(70px); opacity: 0.28;
  }
  .hs-aura, .hs-orbit { position: absolute; z-index: 1; width: 86%; right: -4%; transform: perspective(1400px) rotateY(-12deg); transform-origin: 0% 50%; }
  .hs-aura { top: 0; }
  .hs-orbit { top: 37%; }
  .hs-phone { position: absolute; z-index: 3; left: 0; bottom: 0; width: 40%; }
  .hs-chip {
    position: absolute; z-index: 4; display: none; align-items: center; gap: 9px; padding: 8px 14px 8px 8px; border-radius: 999px;
    font-size: 13.5px; font-weight: 600; color: #fff; background: rgba(16, 19, 26, 0.86); backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.14), 0 20px 40px -16px rgba(0,0,0,0.9);
  }
  @media (min-width: 768px) {
    .hs { aspect-ratio: 1240 / 700; }
    .hs::before { left: 10%; right: 10%; top: 20%; bottom: 14%; filter: blur(90px); opacity: 0.32; }
    .hs-aura, .hs-orbit { width: 52%; top: 9%; }
    .hs-aura { left: 0; right: auto; transform: perspective(1800px) rotateY(14deg); transform-origin: 100% 50%; }
    .hs-orbit { right: 0; transform: perspective(1800px) rotateY(-14deg); transform-origin: 0% 50%; }
