---
import { u, GITHUB, AURA_GITHUB, GUIDE, PDF, BLOB, ORBIT_DEMO, ORBIT_GUIDE, AURA_APP, AURA_GUIDE, STUDIO_RELEASES } from '../data/site';
import { imageSrc } from '../data/images';
import ProductIcon from './ProductIcon.astro';
const cols = [
  { product: 'power' as const, title: 'Page Power', links: [
    ['Mac', u('mac/')], ['iPhone', u('iphone/')], ['Android', u('android/')], ['Page Relay', u('relay/')], ['Self-hosting guide', GUIDE],
  ] },
  { product: 'aura' as const, title: 'Page Aura', links: [
    ['Overview', u('aura/')], ['Open in your browser', AURA_APP], ['Download', STUDIO_RELEASES], ['Guide', AURA_GUIDE],
  ] },
  { product: 'orbit' as const, title: 'Page Orbit', links: [
    ['Overview', u('orbit/')], ['Try the demo', ORBIT_DEMO], ['Download', STUDIO_RELEASES], ['Guide', ORBIT_GUIDE],
  ] },
];
const ext = (href: string) => href.startsWith('http');
---
<footer class="no-print relative mt-10 border-t border-white/[0.07] bg-night-950/80">
  <div class="wrap-wide grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1fr]">
    <div>
      <a href={u()} class="flex items-center gap-2.5 font-extrabold tracking-tight">
        <img src={imageSrc('app-icon')} width="32" height="32" alt="" class="rounded-[9px]" loading="lazy" />
        <span class="text-lg">Page Studio</span>
      </a>
      <p class="fine mt-4 max-w-xs">Free apps for working with AI, that you run yourself: keep watch over your agents, chat on your own key, and answer from your phone.</p>
      <p class="fine mt-4 max-w-xs"><strong class="font-semibold text-ink-2">Page Studio License.</strong> Free to use and share; not to modify, sell, or sell hosting or support of it as a product.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={u('brochure/')} class="btn-ghost !min-h-[38px] !px-4 !text-[13.5px]">Brochure</a>
        <a href={u(PDF)} download class="btn-ghost !min-h-[38px] !px-4 !text-[13.5px]">Download PDF</a>
      </div>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2 class="flex items-center gap-2 text-[14px] font-semibold text-ink"><ProductIcon product={c.product} size={20} /> {c.title}</h2>
        <ul class="mt-4 space-y-2.5 text-[14.5px]">
          {c.links.map(([label, href]) => <li><a href={href} rel={ext(href) ? 'noopener' : undefined} class="text-ink-2 hover:text-ink">{label}</a></li>)}
        </ul>
      </nav>
    ))}
    <nav aria-label="Project links">
      <h2 class="text-[14px] font-semibold text-ink">Project</h2>
      <ul class="mt-4 space-y-2.5 text-[14.5px]">
        <li><a href={GITHUB} rel="noopener" class="text-ink-2 hover:text-ink">GitHub: roysinclair/page</a></li>
        <li><a href={AURA_GITHUB} rel="noopener" class="text-ink-2 hover:text-ink">GitHub: roysinclair/page-studio-apps</a></li>
        <li><a href={BLOB + 'LICENSE'} rel="noopener" class="text-ink-2 hover:text-ink">License</a></li>
        <li><a href={BLOB + 'SECURITY.md'} rel="noopener" class="text-ink-2 hover:text-ink">Security</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap-wide border-t border-white/[0.06] py-7">
    <p class="fine max-w-4xl">Page Studio (Page Power, Page Aura and Page Orbit) is an independent project, <strong class="font-semibold text-ink-2">not affiliated with, endorsed by or sponsored by Anthropic</strong>, OpenAI or Cloudflare. Claude and Claude Code are trademarks of Anthropic, PBC, named here only to say what the apps work with. Page Studio is built on Anthropic’s Claude Code, OpenAI’s Codex, Cloudflare Workers and Durable Objects, and XcodeGen. No analytics, no tracking, no third-party scripts.</p>
  </div>
</footer>
