.DS_Store

# Swift / SwiftPM
.build/
.swiftpm/
# Package.resolved is committed (pins the Linux dependencies; see ci.yml). A macOS `swift build` or
# `swift package resolve` deletes it because the macOS manifest has no dependencies: `git restore Package.resolved`.
ClaudePowerMode.app/
Page.app/
Page Studio.app/
PageAI.app/

# Xcode
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
iOS/build/

# Cloudflare / Node
Cloudflare/node_modules/
Cloudflare/.wrangler/
Cloudflare/.dev.vars
Cloudflare/.dev.vars.*

# Pencil sim screenshots — local working captures, regenerated on demand
Designs/sim-screenshots/

# Logs / local state
*.log

# Local-only Claude Code settings (contains absolute paths)
.claude/settings.local.json

# Python bytecode (hooks/page-extract-context.py)
__pycache__/

# Secrets: signing keys, APNs keys, keystores — never commit
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# Claude Code agent worktrees (local copies of this repo)
.claude/
