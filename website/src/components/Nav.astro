---
import { nav, u, GITHUB, PDF } from '../data/site';
import { imageSrc } from '../data/images';
interface Props { current?: string }
const { current = '' } = Astro.props;
const isCur = (href: string) => (href || '') === current;
---
<header class="no-print sticky top-0 z-50 border-b border-white/[0.07] bg-night-900/80 backdrop-blur-xl">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={u()} class="flex items-center gap-2.5 font-extrabold tracking-tight" aria-label="Page Studio home">
      <span class="brand-mark" data-motion="pulse" data-tone="teal"><img src={imageSrc('app-icon')} width="30" height="30" alt="" class="relative rounded-[8px]" /></span>
      <span class="text-[17px]">Page <span class="text-ink-3 font-semibold">Studio</span></span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {nav.map((n) => (
        <a href={u(n.href)} aria-current={isCur(n.href) ? 'page' : undefined}
           class={`nav-link rounded-lg px-3 py-2 text-[14px] font-medium ${isCur(n.href) ? 'bg-white/[0.08] text-ink' : 'text-ink-2 hover:text-ink'}`}>{n.label}</a>
      ))}
      <a href={GITHUB} rel="noopener" class="nav-link rounded-lg px-3 py-2 text-[14px] font-medium text-ink-2 hover:text-ink">GitHub</a>
      <a href={u(PDF)} class="btn-ghost ml-2 !min-h-[36px] !px-3.5 !py-1.5 !text-[13px]" download>Download PDF</a>
    </nav>

    <details class="group relative lg:hidden">
      <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-2 rounded-xl bg-white/[0.06] px-4 text-[14px] font-semibold ring-1 ring-white/10 [&::-webkit-details-marker]:hidden">
        Menu
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="transition-transform group-open:rotate-180"><path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <div class="absolute right-0 top-14 w-[min(86vw,320px)] rounded-2xl bg-night-800 p-2 ring-1 ring-white/10 shadow-2xl">
        {nav.map((n) => (
          <a href={u(n.href)} aria-current={isCur(n.href) ? 'page' : undefined}
             class={`block rounded-xl px-4 py-3 text-[15px] font-medium ${isCur(n.href) ? 'bg-white/[0.08] text-ink' : 'text-ink-2'}`}>{n.label}</a>
        ))}
        <a href={GITHUB} rel="noopener" class="block rounded-xl px-4 py-3 text-[15px] font-medium text-ink-2">GitHub</a>
        <a href={u(PDF)} download class="mt-1 block rounded-xl bg-white/[0.06] px-4 py-3 text-[15px] font-semibold">Download PDF</a>
      </div>
    </details>
  </div>
</header>
