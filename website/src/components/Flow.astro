---
// How Page Studio connects, as live HTML (it reflows: a row on wide screens, a column on phones or when `vertical`).
// Coding agents, Page Aura and Page Orbit all reach Page Studio on the same computer; Page Studio connects out to your own
// relay; your phone connects out to the same relay. Comets travel each link: pages out, replies back
// (styles/motion.css, .flow-line). Facts from docs/AURA-LINK.md, docs/ORBIT-LINK.md and Cloudflare/README.md.
import ProductIcon from './ProductIcon.astro';
import Icon from './Icon.astro';
interface Props { vertical?: boolean; sources?: boolean; compact?: boolean; class?: string }
const { vertical = false, sources = true, compact = false, class: cls = '' } = Astro.props;
const links = [
  { top: 'same computer', bottom: 'local socket', dl: '0s' },
  { top: 'outbound wss', bottom: 'live sessions sealed end to end', dl: '-0.9s' },
  { top: 'wss · HTTPS', bottom: 'Apple push optional', dl: '-1.8s' },
];
const Link = links;
const label = (sources ? 'How Page Studio connects: AI coding agents, Page Aura and Page Orbit reach Page Studio on your computer. ' : '')
  + 'Page Studio connects out to Page Relay, a Cloudflare Worker on your own account; your phone connects out to the same relay.';
---
<div class={`flow ${vertical ? 'vert' : ''} ${sources ? '' : 'nosrc'} ${compact ? 'compact' : ''} ${cls}`} role="group" aria-label={label}>
  {sources && <div class="flow-sources">
    <div class="flow-src" style="--c:#5EEAD4">
      <span class="flow-ico"><Icon name="terminal" size={18} /></span>
      <span class="min-w-0"><strong>Coding agents</strong><small>Claude Code · Codex · local</small></span>
    </div>
    <div class="flow-src" style="--c:#4f86ff">
      <ProductIcon product="aura" size={30} />
      <span class="min-w-0"><strong>Page Aura</strong><small>chat on your key</small></span>
    </div>
    <div class="flow-src" style="--c:#b73bce">
      <ProductIcon product="orbit" size={30} />
      <span class="min-w-0"><strong>Page Orbit</strong><small>Managed Agents</small></span>
    </div>
  </div>}

  {[0, 1, 2].map((i) => (
    <Fragment>
      {(sources || i > 0) && <div class="flow-link" aria-hidden="true">
        <span class="flow-tag top">{Link[i].top}</span>
        <span class={`flow-line v`} style={`--t:2.8s;--dl:${Link[i].dl}`}></span>
        <span class={`flow-line v back`} style={`--t:2.8s;--dl:${Link[i].dl};--c1:#9b7bff;--c2:#9b7bff`}></span>
        <span class="flow-tag bottom">{Link[i].bottom}</span>
      </div>}
      {i === 0 && (
        <div class="flow-node hero">
          <ProductIcon product="power" size={44} glow />
          <strong>Page Studio</strong>
          <small>your Mac · Linux preview</small>
          <em>Power keeps it awake · Relay pages you</em>
        </div>
      )}
      {i === 1 && (
        <div class="flow-node">
          <span class="flow-ico big"><Icon name="cloud" size={22} /></span>
          <strong>Page Relay</strong>
          <small>Worker on your Cloudflare</small>
          <em>yours, not ours</em>
        </div>
      )}
      {i === 2 && (
        <div class="flow-node">
          <span class="flow-ico big"><Icon name="phone" size={22} /></span>
          <strong>Page Relay app</strong>
          <small>iPhone · Android</small>
          <em>answer from the lock screen</em>
        </div>
      )}
    </Fragment>
  ))}
</div>
