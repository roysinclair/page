---
import '@fontsource-variable/inter/opsz.css'; // Inter with its optical-size axis: Inter Display at heading sizes
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/motion.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { u } from '../data/site';
import { OG_IMAGE, OG_SIZE } from '../data/images';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  bare?: boolean; // brochure: no footer on print is handled in CSS; bare drops the footer entirely
  motion?: boolean; // false: no signature motion at all (the brochure, which is also printed to PDF)
  world?: 'studio' | 'power' | 'aura' | 'orbit'; // the product colours this page wears (styles/global.css)
  og?: { image: string; alt: string }; // social card (1200 x 630, under public/); Page Studio for Mac's card by default
}
const {
  title = 'Page Studio',
  description = 'Page Studio is a family of free, source-available apps you run yourself. On your Mac (and Linux, in preview), Page Power keeps your AI coding agents running and Page Relay pages your phone and types your replies back. Page Aura is chat on your own credits, and Page Orbit manages and controls Anthropic Managed Agents.',
  current = '',
  bare = false,
  motion = true,
  world = 'power',
  og = { image: OG_IMAGE, alt: 'Page Studio: your agents keep working, you get paged only when it matters. An iPhone lock screen with two Page Relay notifications beside the Page Studio menu-bar popover.' },
} = Astro.props;
const full = title === 'Page Studio' ? 'Page Studio — run your AI agents, answer them from anywhere' : `${title} · Page Studio`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(u(og.image), Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#05070D" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={u('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Page Studio" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content={String(OG_SIZE[0])} />
    <meta property="og:image:height" content={String(OG_SIZE[1])} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={og.alt} />
    <!--
      SIGNATURE MOTION. Each hook is a `data-motion` attribute using the slug of a signature animation in
      Designs/v4-night-watch-spec.json; styles/motion.css and scripts/motion.ts implement them for the web,
      with the app's own timings (iOS/Page/Models: PulseModel, ApproachModel, ReceiptThread, HoldRing, DawnModel):
        pulse            -> 1. The Pulse: teal breath every 4 s, one amber ripple ring per waiting item, still star-white
                               when quiet. Nav mark and every <Pulse>.
        final-approach   -> 2. Final Approach: arrivals descend from the pulse on spring(response .5, damping .8),
                               520 ms, glow off once settled. Home hero composition, the kinds of page, lead visuals.
        receipt-thread   -> 3. The Receipt Thread: a page goes Mac -> relay -> phone, the reply's thread returns, and
                               turns green only when the Mac confirms. ConnectDiagram, and the delivery chips.
        hold-ring        -> 4. The Hold Ring: 300 ms dead zone, fills over 1.2 s, amber warming to red in its final
                               third; release early and it unwinds. <HoldRing> (a pressable demo).
        dusk-dawn        -> 5. Dusk and Dawn: the page's sky (.nw-sky) shifts from working aurora to dusk to dawn as you
                               scroll; the battery tile and box play dusk then a dawn sweep.
      The CSS default is always the finished state. The `motion` class below is set only when motion is allowed
      (no Reduce Motion, not printing, not opted out with motion={false}), so Reduce Motion, print, the brochure
      and a failed script all get the static, finished design. Everything animates transform and opacity only,
      except the hold ring's stroke, and starts from an IntersectionObserver.
    -->
    <script is:inline define:vars={{ allow: motion }}>
      (function () {
        var d = document.documentElement;
        if (!allow || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('print').matches) return;
        d.classList.add('motion');
        // If the motion script never starts, fall back to the finished design.
        setTimeout(function () { if (!d.classList.contains('motion-live')) d.classList.remove('motion'); }, 2500);
      })();
    </script>
  </head>
  <body class={`stars text-ink world-${world}`}>
    <div class="nw-sky no-print" aria-hidden="true"><i class="sky-work"></i><i class="sky-dusk"></i><i class="sky-dawn"></i></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-night-800 focus:px-4 focus:py-2">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>import '../scripts/motion';</script>
  </body>
</html>
