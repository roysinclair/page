---
// The hero for Page Power's own pages (Mac, iPhone, Android, Relay): the product mark, a big headline whose last
// phrase (`accent`) wears the world gradient, the lede and actions, and a visual on an aurora.
import Field from './Field.astro';
import ProductIcon from './ProductIcon.astro';
interface Props { label: string; title: string; accent?: string; lede: string; class?: string; product?: 'power' | 'aura' | 'orbit' }
const { label, title, accent, lede, class: cls = '', product = 'power' } = Astro.props;
---
<section class={`relative isolate overflow-hidden ${cls}`}>
  <Field layout="right" />
  <div class="wrap-wide grid items-center gap-12 pb-16 pt-12 sm:pb-24 sm:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14">
    <div>
      <div class="flex items-center gap-3.5">
        <ProductIcon product={product} size={44} glow />
        <p class="label">{label}</p>
      </div>
      <h1 class="h1 mt-7 !text-[40px] sm:!text-[56px] lg:!text-[64px]">{title}{accent && <> <span class="text-world">{accent}</span></>}</h1>
      <p class="lede mt-6 max-w-xl">{lede}</p>
      <div class="mt-9 flex flex-wrap gap-3"><slot name="actions" /></div>
    </div>
    <div class="halo min-w-0"><slot /></div>
  </div>
</section>
