---
import { terminals } from '../data/site';
import Mark from './Mark.astro';
const cols: [string, keyof typeof terminals[0]][] = [
  ['Type replies', 'reply'], ['Read the screen', 'screen'], ['Press Esc', 'stop'], ['Start sessions', 'start'], ['Answer questions', 'answer'],
];
---
<!-- Desktop: table -->
<div class="scroll-x hidden md:block">
  <table class="w-full min-w-[760px] border-separate border-spacing-0 text-left text-[14px]">
    <caption class="sr-only">What Page Relay can do in each supported terminal, for Claude Code sessions</caption>
    <thead>
      <tr class="text-ink-3">
        <th scope="col" class="sticky left-0 border-b border-white/10 bg-night-900 px-3 py-3 font-semibold">Terminal</th>
        {cols.map(([l]) => <th scope="col" class="border-b border-white/10 px-3 py-3 text-center font-semibold">{l}</th>)}
        <th scope="col" class="border-b border-white/10 px-3 py-3 font-semibold">Photos from phone</th>
        <th scope="col" class="border-b border-white/10 px-3 py-3 font-semibold">What it needs</th>
      </tr>
    </thead>
    <tbody>
      {terminals.map((t) => (
        <tr class="align-top">
          <th scope="row" class="sticky left-0 border-b border-white/[0.06] bg-night-900 px-3 py-4 text-[15px] font-bold">{t.name}</th>
          {cols.map(([, k]) => <td class="border-b border-white/[0.06] px-3 py-4 text-center text-[16px]"><Mark v={t[k] as any} /></td>)}
          <td class="border-b border-white/[0.06] px-3 py-4 text-ink-2">{t.photos === 'attached' ? 'Attached as an image' : 'File location'}</td>
          <td class="border-b border-white/[0.06] px-3 py-4 text-ink-2">{t.setup}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<!-- Phone: cards -->
<div class="grid gap-4 md:hidden">
  {terminals.map((t) => (
    <div class="card !p-5">
      <h3 class="h3 !text-lg">{t.name}</h3>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {cols.map(([l, k]) => <li class={`chip ${t[k] === "yes" ? "!text-pulse-teal" : "!text-ink-3 line-through"}`}>{t[k] !== "yes" && <span class="sr-only">Not available: </span>}{l}</li>)}
        <li class="chip">{t.photos === 'attached' ? 'Photos attached' : 'Photos as file location'}</li>
      </ul>
      <p class="fine mt-3">{t.setup}</p>
    </div>
  ))}
</div>
